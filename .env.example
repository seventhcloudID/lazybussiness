PORT=8080
# THREADS_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=

AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.6-flash
AI_API_KEY=
# Tambahan key (koma-pisah) — otomatis rotasi jika kena limit/429
# AI_API_KEYS=key2,key3
# AI_API_KEY_2=

# Estimasi free tier per key (dikali jumlah key untuk tracker lokal)
AI_TIER=free
AI_QUOTA_RPM=10
AI_QUOTA_RPD=250
AI_QUOTA_TPM=250000

# Lazy Business 24/7 — URL publik agar Meta bisa fetch gambar carousel
# Contoh: https://xxx.trycloudflare.com  (tanpa trailing slash)
# PUBLIC_BASE_URL=
# LAZY_TIMEZONE=Asia/Jakarta
