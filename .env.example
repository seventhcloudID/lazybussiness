# ===== Server =====
PORT=8080

# ===== Login dashboard (WAJIB di VPS) =====
AUTH_USER=admin
AUTH_PASSWORD=ganti-dengan-password-kuat
AUTH_SECRET=ganti-dengan-string-acak-panjang
AUTH_SECURE=1

# ===== OpenAPI / GPT Actions / Hermes (opsional) =====
# Bearer key untuk connect eksternal. Bisa juga dibuat lewat UI Akun → Connect API.
# Spec: {PUBLIC_BASE_URL}/openapi.yaml
# CONNECT_API_KEY=mn_ganti_dengan_secret_panjang

# ===== URL publik (WAJIB untuk OAuth + auto carousel IG) =====
PUBLIC_BASE_URL=https://flowa.tigaawan.com
LAZY_TIMEZONE=Asia/Jakarta

# ===== OAuth Threads / Instagram (Meta App Dashboard) =====
# Redirect URL (URL Callback Alihkan):
#   {PUBLIC_BASE_URL}/auth/threads/callback
#   {PUBLIC_BASE_URL}/auth/instagram/callback
# Hapus Instalan URL Callback (Deauthorize):
#   {PUBLIC_BASE_URL}/auth/meta/deauthorize
# Hapus URL Callback (Data Deletion):
#   {PUBLIC_BASE_URL}/auth/meta/data-deletion
THREADS_APP_ID=
THREADS_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opsional — kalau App ID sama untuk keduanya:
# META_APP_ID=
# META_APP_SECRET=

# ===== Threads (boleh dikosongkan — isi lewat UI / OAuth) =====
THREADS_ACCESS_TOKEN=

# ===== Instagram (boleh dikosongkan — isi lewat UI / OAuth) =====
INSTAGRAM_ACCESS_TOKEN=

# ===== AI / Gemini (teks: generate utas, balasan, carousel copy) =====
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.6-flash
# Chat UI Google Search (Gemini 3 free sering tidak support grounding → default 2.5 Flash)
# AI_SEARCH_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_API_KEYS=
# AI_API_KEY_2=
# AI_API_KEY_3=
# Atau isi lewat UI: Settings → Gemini API (.data/ai_keys.json)

# Estimasi kuota lokal per key (dikali jumlah key)
AI_TIER=free
AI_QUOTA_RPM=10
AI_QUOTA_RPD=250
AI_QUOTA_TPM=250000

# ===== ChatGPT / OpenAI Images (thumbnail utas Threads 4:3 — bukan IG) =====
OPENAI_API_KEY=
# OPENAI_API_KEYS=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=low
# Output lab default di-crop/scale ke 1024x768 (4:3)

# Lazy Business — thumbnail otomatis tiap generate utas (Threads bagian 1)
# LAZY_THUMB_MODEL=gpt-image-2
# LAZY_THUMB_SIZE=1024x768
# LAZY_THUMB_QUALITY=high

# ===== Buffer (TikTok Notify Me + X shareNow) =====
# Lazy: slide+caption → TikTok antrian; parts utas → X publish sekarang.
# API key: https://publish.buffer.com/settings/api
# Opsional: seed Buffer key ke akun aktif saat pertama jalan (lalu disimpan per-akun di UI).
BUFFER_API_KEY=
# Opsional — kosong = auto-detect
# BUFFER_TIKTOK_CHANNEL_ID=
# BUFFER_TWITTER_CHANNEL_ID=
# BUFFER_ORG_ID=
# BUFFER_ENABLED=0
